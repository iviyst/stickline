{
  "stickline": {
    "lobby": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "!newData.exists() || (newData.child('u').isString() && newData.child('u').val().length <= 40 && newData.child('r').isString() && newData.child('r').val().matches(/^Q[A-Z0-9]{6}$/) && newData.child('t').isNumber() && (!newData.child('by').exists() || (newData.child('by').isString() && newData.child('by').val().length <= 40)))"
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "m/c"
      ],
      "$room": {
        ".validate": "$room.matches(/^([A-Z0-9]{4}|Q[A-Z0-9]{6})$/)",
        ".write": "auth != null && (!data.exists() || data.child('m/h').val() === auth.uid || data.child('m/g').val() === auth.uid || (!newData.exists() && data.child('m/c').val() < now - 10800000))",
        "m": {
          ".write": "auth != null && data.exists() && !data.child('g').exists() && newData.child('g').val() === auth.uid && newData.child('h').val() === data.child('h').val() && newData.child('s').val() === data.child('s').val()",
          ".validate": "newData.hasChildren(['h', 'hn', 's', 'st', 'c'])",
          "h": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "g": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "hn": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "gn": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "hw": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "gw": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "s": {
            ".validate": "newData.isNumber()"
          },
          "st": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "c": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "p": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.hasChildren(['x', 'y', 'f'])",
            "x": {
              ".validate": "newData.isNumber()"
            },
            "y": {
              ".validate": "newData.isNumber()"
            },
            "f": {
              ".validate": "newData.isNumber()"
            },
            "a": {
              ".validate": "newData.isNumber()"
            },
            "s": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "hits": {
          "$h": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['to', 'kx', 'ky', 'st', 't']) && newData.child('kx').isNumber() && newData.child('kx').val() >= -800 && newData.child('kx').val() <= 800 && newData.child('ky').isNumber() && newData.child('ky').val() >= 0 && newData.child('ky').val() <= 500 && newData.child('st').isNumber() && newData.child('st').val() <= 1 && newData.child('to').isString() && newData.child('t').isNumber()"
          }
        },
        "win": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || (newData.child('u').val() === auth.uid && newData.child('t').isNumber() && newData.child('at').isNumber())"
        },
        "left": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "re": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "h4": {
      ".read": "auth != null",
      ".indexOn": [
        "m/c"
      ],
      "$room": {
        ".validate": "$room.matches(/^[A-Z0-9]{4}$/) && newData.hasChild('m')",
        ".write": "auth != null && ((!data.exists() && newData.child('m/h').val() === auth.uid) || (!newData.exists() && (data.child('m/h').val() === auth.uid || data.child('m/c').val() < now - 10800000)))",
        "m": {
          ".write": "auth != null && data.exists() && data.child('h').val() === auth.uid && newData.child('h').val() === auth.uid",
          ".validate": "newData.hasChildren(['h', 's', 'st', 'c'])",
          "h": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "s": {
            ".validate": "newData.isNumber()"
          },
          "st": {
            ".validate": "newData.isString() && (newData.val() === 'wait' || newData.val() === 'go')"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "c": {
            ".validate": "newData.isNumber()"
          },
          "pub": {
            ".validate": "newData.isNumber()"
          },
          "rd": {
            ".validate": "newData.isNumber()"
          },
          "auto": {
            ".validate": "newData.isNumber()"
          },
          "ver": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "slots": {
          "$i": {
            ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['u', 'n', 'k']) && (newData.child('k').val() === 'h' || (newData.child('k').val() === 'b' && newData.child('u').val() === 'b' + $i))",
            ".write": "auth != null && ((root.child('stickline').child('h4').child($room).child('m').child('h').val() === auth.uid && $i !== '0' && (!data.exists() || data.child('k').val() === 'b') && (!newData.exists() || newData.child('k').val() === 'b')) || (root.child('stickline').child('h4').child($room).child('m').child('h').val() === auth.uid && $i === '0' && newData.child('u').val() === auth.uid) || (!data.exists() && $i !== '0' && newData.child('u').val() === auth.uid && newData.child('k').val() === 'h' && root.child('stickline').child('h4').child($room).child('m').child('st').val() === 'wait') || (data.child('u').val() === auth.uid && data.child('k').val() === 'h' && (!newData.exists() || newData.child('u').val() === auth.uid)))",
            "u": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "k": {
              ".validate": "newData.isString() && (newData.val() === 'h' || newData.val() === 'b')"
            },
            "w": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "lv": {
              ".validate": "newData.isString() && (newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'hard')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "p": {
          "$id": {
            ".write": "auth != null && ($id === auth.uid || (root.child('stickline').child('h4').child($room).child('m').child('h').val() === auth.uid && $id.matches(/^b[1-3]$/)))",
            ".validate": "!newData.exists() || newData.hasChildren(['x', 'y', 'f'])",
            "x": {
              ".validate": "newData.isNumber()"
            },
            "y": {
              ".validate": "newData.isNumber()"
            },
            "f": {
              ".validate": "newData.isNumber()"
            },
            "a": {
              ".validate": "newData.isNumber()"
            },
            "s": {
              ".validate": "newData.isNumber()"
            },
            "r": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "hits": {
          "$h": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['to', 'kx', 'ky', 'st', 't']) && newData.child('kx').isNumber() && newData.child('kx').val() >= -800 && newData.child('kx').val() <= 800 && newData.child('ky').isNumber() && newData.child('ky').val() >= 0 && newData.child('ky').val() <= 500 && newData.child('st').isNumber() && newData.child('st').val() >= 0 && newData.child('st').val() <= 1 && newData.child('to').isString() && newData.child('to').val().length <= 40 && newData.child('t').isNumber()",
            "to": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "kx": {
              ".validate": "newData.isNumber()"
            },
            "ky": {
              ".validate": "newData.isNumber()"
            },
            "st": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "wp": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "win": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && root.child('stickline').child('h4').child($room).child('m').child('h').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['u', 't', 'at']) && (newData.child('u').val() === auth.uid || (root.child('stickline').child('h4').child($room).child('m').child('h').val() === auth.uid && newData.child('u').val().matches(/^b[1-3]$/))) && newData.child('t').isNumber() && newData.child('at').isNumber())",
          "u": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "h4pub": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$room": {
        ".validate": "$room.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren(['h', 't', 'n', 'c'])",
        ".write": "auth != null && ((!data.exists() && newData.child('h').val() === auth.uid) || (data.child('h').val() === auth.uid && newData.child('h').val() === auth.uid) || (!newData.exists() && (data.child('h').val() === auth.uid || data.child('t').val() < now - 120000)))",
        "h": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": "newData.isNumber()"
        },
        "c": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
